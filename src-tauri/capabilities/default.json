{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions the settings window and the break overlays need.",
  "windows": [
    "main",
    "overlay-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default",
    "autostart:default",
    "opener:default"
  ]
}
